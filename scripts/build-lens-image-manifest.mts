import { createHash } from "node:crypto";
import { existsSync, mkdirSync, readdirSync, readFileSync, writeFileSync } from "node:fs";
import { resolve } from "node:path";
import { publicAssetManifestSchema } from "./lib/public-assets.mts";

const publicLensesDir = resolve(process.cwd(), "public/lenses");
const outputPath = resolve(process.cwd(), "src/data/lens-images.generated.ts");
const entries = existsSync(publicLensesDir) ? readdirSync(publicLensesDir, { withFileTypes: true }) : [];
if (entries.some(entry => entry.isDirectory())) {
  throw new Error("Lens images other than primary images must use the public asset registry, not public/lenses subdirectories");
}
const files = entries.filter(entry => entry.isFile() && entry.name.endsWith(".webp")).map(entry => entry.name).sort();
const hashes = Object.fromEntries(files.map(file => [
  file.slice(0, -".webp".length),
  createHash("sha256").update(readFileSync(resolve(publicLensesDir, file))).digest("hex").slice(0, 12),
]));
const manifest = publicAssetManifestSchema.parse(JSON.parse(readFileSync(resolve("src/data/public-assets.json"), "utf8")));
const catalogPaths = ["src/data/lenses.json", "src/data/lenses-gfx.json"].filter(file => existsSync(resolve(file)));
if (catalogPaths.length) {
  const required = new Set<string>();
  for (const file of catalogPaths) {
    const lenses = JSON.parse(readFileSync(resolve(file), "utf8")) as { id: string; images?: { id: string }[] }[];
    for (const lens of lenses) {
      if (Object.hasOwn(lens, "alternateImages")) {
        throw new Error(`Unsupported image field in ${lens.id}: alternateImages`);
      }
      for (const image of lens.images ?? []) {required.add(`lens-images/${lens.id}/${image.id}`);}
    }
  }
  const owned = Object.keys(manifest.assets).filter(id => id.startsWith("lens-images/"));
  if (required.size !== owned.length || [...required].some(id => !Object.hasOwn(manifest.assets, id))) {
    throw new Error("Lens image resources do not match the pinned lens catalog");
  }
}
mkdirSync(resolve(outputPath, ".."), { recursive: true });
writeFileSync(outputPath, `// AUTOGENERATED by scripts/build-lens-image-manifest.mts — do not edit.\nexport const LENS_IMAGE_HASHES: Readonly<Record<string, string>> = ${JSON.stringify(hashes, null, 2)};\n`);
console.log(`✓ wrote lens-images.generated.ts (${files.length} primary)`);
