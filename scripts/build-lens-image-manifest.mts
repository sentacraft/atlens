import { createHash } from "node:crypto";
import { existsSync, mkdirSync, readdirSync, readFileSync, writeFileSync } from "node:fs";
import { resolve } from "node:path";
import { parse } from "smol-toml";
import { z } from "zod";

const publicLensesDir = resolve(process.cwd(), "public/lenses");
const outputPath = resolve(process.cwd(), "src/data/lens-images.generated.ts");
const entries = existsSync(publicLensesDir) ? readdirSync(publicLensesDir, { withFileTypes: true }) : [];
if (entries.some(entry => entry.isDirectory())) {
  throw new Error("Supplemental images must be hosted in R2, not public/lenses subdirectories");
}
const files = entries.filter(entry => entry.isFile() && entry.name.endsWith(".webp")).map(entry => entry.name).sort();
const hashes = Object.fromEntries(files.map(file => [
  file.slice(0, -".webp".length),
  createHash("sha256").update(readFileSync(resolve(publicLensesDir, file))).digest("hex").slice(0, 12),
]));

const resources = z.object({
  version: z.literal(1),
  images: z.record(
    z.string().regex(/^[a-z0-9]+(?:-[a-z0-9]+)*\/\d{3,}$/),
    z.object({ key: z.string(), sha256: z.string().regex(/^[a-f0-9]{64}$/) }).strict(),
  ),
}).strict().parse(JSON.parse(readFileSync(resolve("src/data/lens-supplemental-images.json"), "utf8")));

const config = parse(readFileSync(resolve("wrangler.toml"), "utf8")) as unknown as {
  vars: { SUPPLEMENTAL_IMAGES_URL: string };
  previews: { vars: { SUPPLEMENTAL_IMAGES_URL: string } };
};
const preview = process.env.WORKERS_CI_BRANCH && process.env.WORKERS_CI_BRANCH !== "main";
const baseUrl = process.env.SUPPLEMENTAL_IMAGES_URL ?? (preview ? config.previews.vars : config.vars).SUPPLEMENTAL_IMAGES_URL;
const origin = new URL(baseUrl);
if (origin.protocol !== "https:" || origin.origin !== baseUrl || origin.username || origin.password) {
  throw new Error("SUPPLEMENTAL_IMAGES_URL must be an HTTPS origin without credentials");
}
const supplemental = Object.fromEntries(Object.entries(resources.images).sort(([a], [b]) => a.localeCompare(b)).map(([id, image]) => {
  if (image.key !== `supplemental/${id}.${image.sha256}.webp`) {
    throw new Error(`Invalid supplemental image key: ${id}`);
  }
  return [id, `${baseUrl}/${image.key}`];
}));

const catalogPaths = ["src/data/lenses.json", "src/data/lenses-gfx.json"].filter(file => existsSync(resolve(file)));
if (catalogPaths.length) {
  const required = new Set<string>();
  for (const file of catalogPaths) {
    const lenses = JSON.parse(readFileSync(resolve(file), "utf8")) as {
      id: string; images?: { id: string }[];
    }[];
    for (const lens of lenses) {
      if (Object.hasOwn(lens, "alternateImages")) {
        throw new Error(`Unsupported image field in ${lens.id}: alternateImages`);
      }
      for (const image of lens.images ?? []) {
        required.add(`${lens.id}/${image.id}`);
      }
    }
  }
  if (required.size !== Object.keys(supplemental).length || [...required].some(id => !Object.hasOwn(supplemental, id))) {
    throw new Error("Supplemental resource manifest does not match the pinned lens catalog");
  }
}

const ts = `// AUTOGENERATED by scripts/build-lens-image-manifest.mts — do not edit.
export const LENS_IMAGE_HASHES: Readonly<Record<string, string>> = ${JSON.stringify(hashes, null, 2)};
export const LENS_SUPPLEMENTAL_IMAGES: Readonly<Record<string, string>> = ${JSON.stringify(supplemental, null, 2)};
`;
mkdirSync(resolve(outputPath, ".."), { recursive: true });
writeFileSync(outputPath, ts, "utf8");
console.log(`✓ wrote lens-images.generated.ts (${files.length} primary, ${Object.keys(supplemental).length} supplemental)`);
