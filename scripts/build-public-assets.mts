import { mkdirSync, readFileSync, writeFileSync } from "node:fs";
import { resolve } from "node:path";
import { parse } from "smol-toml";
import { publicAssetManifestSchema } from "./lib/public-assets.mts";

const manifest = publicAssetManifestSchema.parse(JSON.parse(readFileSync(resolve("src/data/public-assets.json"), "utf8")));
const config = parse(readFileSync(resolve("wrangler.toml"), "utf8")) as unknown as {
  vars: { PUBLIC_ASSETS_URL: string };
  previews: { vars: { PUBLIC_ASSETS_URL: string } };
};
const preview = process.env.WORKERS_CI_BRANCH && process.env.WORKERS_CI_BRANCH !== "main";
const baseUrl = process.env.PUBLIC_ASSETS_URL ?? (preview ? config.previews.vars : config.vars).PUBLIC_ASSETS_URL;
const origin = new URL(baseUrl);
if (origin.protocol !== "https:" || origin.origin !== baseUrl || origin.username || origin.password) {
  throw new Error("PUBLIC_ASSETS_URL must be an HTTPS origin without credentials");
}
const urls = Object.fromEntries(Object.entries(manifest.assets).sort(([a], [b]) => a.localeCompare(b)).map(([id, asset]) => [id, `${baseUrl}/${asset.key}`]));
const output = resolve("src/data/public-assets.generated.ts");
mkdirSync(resolve(output, ".."), { recursive: true });
writeFileSync(output, `// AUTOGENERATED by scripts/build-public-assets.mts — do not edit.\nexport const PUBLIC_ASSET_URLS: Readonly<Record<string, string>> = ${JSON.stringify(urls, null, 2)};\n`);
console.log(`✓ wrote public-assets.generated.ts (${Object.keys(urls).length} public assets)`);
