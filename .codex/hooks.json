{
  "description": "UI token review hooks for Atlens",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$(git rev-parse --show-toplevel)/.codex/hooks/ui-token-review.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking shared UI tokens"
          }
        ]
      }
    ]
  }
}
