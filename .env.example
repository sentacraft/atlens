# Key for the deployed agent model (the first preset in src/lib/ai/model-presets.ts).
# To try another provider locally, pick a preset in the Test Hook panel, or set
# AGENT_MODEL ("provider:modelId"), and add that provider's key from KEY_VAR in
# src/lib/ai/model.ts (OPENAI_API_KEY, DASHSCOPE_API_KEY, OPENROUTER_API_KEY, ...).
DEEPSEEK_API_KEY=

# Key for qwen3.7-plus, the model DeepSeek replaced; production keeps it until the switch has
# held for a few weeks, so reverting the switch needs no secret change.
DASHSCOPE_API_KEY=

# Local only, never production or CI: the OpenAI key the promptfoo judge uses
# (eval/promptfoo/README.md). Kept apart from OPENAI_API_KEY so eval spend shows
# separately and a revoked app key does not stop the eval.
EVAL_OPENAI_API_KEY=

# GitHub token used to submit feedback issues on behalf of users.
# Requires Issues: Read and Write permission on GITHUB_FEEDBACK_REPO.
GITHUB_TOKEN=your_github_personal_access_token

# The repo where feedback issues are created (format: owner/repo).
GITHUB_FEEDBACK_REPO=owner/repo-name

# Optional comma-separated GitHub usernames to assign to feedback issues.
GITHUB_FEEDBACK_ASSIGNEES=your-github-username

# Optional. Exempts your own testing from the rate limits in src/lib/rate-limit.ts: set a
# `rate_bypass` cookie to this exact value in your browser. High-entropy secret;
# in production set it via `wrangler secret put RATE_LIMIT_BYPASS`. Unset = no bypass.
RATE_LIMIT_BYPASS=

# Better Auth secret used for signing sessions and verification data.
# In production set it via `wrangler secret put BETTER_AUTH_SECRET`.
BETTER_AUTH_SECRET=

# Optional Google OAuth credentials. Set both in the deployment environment to
# enable the Google sign-in button; email OTP remains available without them.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Local origin used by authentication callbacks. Production uses wrangler.toml.
SITE_URL=http://localhost:3000

# Key for anonymizing conversation ids before they are written to Analytics Engine.
# Self-owned: generate with `pnpm run secret:add ANALYTICS_ID_SECRET --generate`.
ANALYTICS_ID_SECRET=

# Encrypts the Google and GitHub sign-in hand-off between production and Worker Previews, the one
# secret both share. Self-owned: `pnpm run secret:add OAUTH_PROXY_SECRET --generate`.
OAUTH_PROXY_SECRET=

# GitHub sign-in: the OAuth App registered under the SentaCraft account, whose only callback
# is production's /api/auth/callback/github; previews reach it through oAuthProxy.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
